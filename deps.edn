{;; jolt-sandbox is a convenience layer over jolt-microvm, so it floors at the
 ;; same 0.8.28 as the rest of the stack.
 :jolt/min-version "0.8.28"

 :paths ["src"]
 :deps {racklr-dev/jolt-microvm
        {:git/url "https://github.com/racklr-dev/jolt-microvm"
         :git/sha "c45dc203ddfb55d8f3fc729321f06cc41b4e6ffa"}}

 :tasks {test "jolt run test/jolt/check_test.clj"}}