 :paths ["src"]
 :deps {racklr-dev/jolt-microvm
        {:git/url "https://github.com/racklr-dev/jolt-microvm"
         :git/sha "48340931c091de7cebdc4afd8dc1e3b8239d8d53"}}

 :tasks {test "jolt run test/jolt/check_test.clj"}}